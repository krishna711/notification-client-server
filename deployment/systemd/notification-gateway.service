[Unit]
Description=Central Notification Gateway (FastAPI + WebSocket)
After=network.target

[Service]
Type=simple
User=yotek-notify
WorkingDirectory=/home/yotek-notify/notification-client-server/server
Environment="PATH=/home/yotek-notify/notification-client-server/venv/bin"
Environment="PORT=8090"
Environment="HOST=127.0.0.1"
Environment="DATABASE_PATH=/home/yotek-notify/notification-client-server/notifications.db"
Environment="NOTIFICATION_API_KEYS=your-secret-api-key"
Environment="DEVICE_AUTH_TOKEN=your-device-secret-token"

ExecStart=/home/yotek-notify/notification-client-server/venv/bin/python run_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
